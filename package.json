{
  "name": "vocabulary-with-ralina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-vocabulary-ralina --only firestore \"node --test tests/security.rules.js\"",
    "test:e2e": "firebase emulators:exec --project demo-vocabulary-ralina --only firestore,auth \"playwright test\""
  },
  "dependencies": { "firebase": "^12.0.0" },
  "devDependencies": {
    "vite": "^7.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "@playwright/test": "^1.55.0"
  }
}
